# SaaS Enterprise API Environment Secrets Configuration
# NUNCA comite este arquivo (.env ou appsettings.Production.json) no repositório Git!

# Configuração de Conexão com Banco de Dados Central
POSTGRES_CONNECTION_STRING="Host=localhost;Database=SaaSDB;Username=postgres;Password=SEU_PASSWORD_SEGURO"

# Configuração de Autenticação Segura JWT (Assinatura de Tokens)
JWT_SECRET_KEY="SUA_CHAVE_SECRETA_JWT_ENTERPRISE_MINIMO_32_CARACTERES"
JWT_ISSUER="SaaS.Enterprise.Api"
JWT_AUDIENCE="SaaS.Enterprise.Web"
JWT_EXPIRATION_HOURS=12

# Configurações de API & CORS
PORT=5205
ALLOWED_ORIGINS="https://app.seusaas.com.br,http://localhost:3000"
